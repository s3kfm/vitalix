    {
      "value": "COALESCE(\n    jsonb_typeof(\"result\") = 'object'\n    AND \"result\" ?& ARRAY['type', 'value']\n    AND (\"result\" - 'type' - 'value') = '{}'::jsonb\n    AND CASE \"result\"->>'type'\n      WHEN 'quantity' THEN jsonb_typeof(\"result\"->'value') = 'object'\n      WHEN 'coded' THEN jsonb_typeof(\"result\"->'value') = 'object'\n      WHEN 'absent' THEN jsonb_typeof(\"result\"->'value') = 'object'\n      WHEN 'range' THEN jsonb_typeof(\"result\"->'value') = 'object'\n      WHEN 'ratio' THEN jsonb_typeof(\"result\"->'value') = 'object'\n      WHEN 'sampledData' THEN jsonb_typeof(\"result\"->'value') = 'object'\n      WHEN 'period' THEN jsonb_typeof(\"result\"->'value') = 'object'\n      WHEN 'string' THEN jsonb_typeof(\"result\"->'value') = 'string'\n      WHEN 'time' THEN jsonb_typeof(\"result\"->'value') = 'string'\n      WHEN 'dateTime' THEN jsonb_typeof(\"result\"->'value') = 'string'\n      WHEN 'boolean' THEN jsonb_typeof(\"result\"->'value') = 'boolean'\n      WHEN 'integer' THEN jsonb_typeof(\"result\"->'value') = 'number'\n      ELSE false END, false)",
      "name": "measurement_result_shape",
      "entityType": "checks",
      "schema": "public",
      "table": "measurement_values"
    },
    {
      "value": "(\"normalizedValue\" IS NULL AND \"normalizedUnit\" IS NULL AND \"conversionVersion\" IS NULL) OR (\"result\"->>'type' = 'quantity' AND \"normalizedValue\" IS NOT NULL AND \"normalizedUnit\" IS NOT NULL AND \"conversionVersion\" IS NOT NULL)",
      "name": "measurement_normalization_complete",
      "entityType": "checks",
      "schema": "public",
      "table": "measurement_values"
    },
    {
      "value": "(\"sourceType\" = 'patient_reported' AND \"captureMethod\" IN ('manual_form', 'ai_conversation')) OR (\"sourceType\" = 'report' AND \"captureMethod\" = 'ai_extraction' AND \"sourceReportId\" IS NOT NULL) OR (\"sourceType\" = 'device' AND \"captureMethod\" = 'device_import')",
      "name": "measurement_source_consistency",
      "entityType": "checks",
      "schema": "public",
      "table": "measurements"
    },
    {
      "value": "\"captureMethod\" <> 'ai_conversation' OR \"sourceMessageId\" IS NOT NULL",
